datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  BOOKS
  FURNITURE
  ELECTRONICS
  CLOTHING
  FREE
  OTHER
  CYCLES_VEHICLES
  DORM_FURNITURE
  APPLIANCES
  SPORTS_FITNESS
  STATIONERY_LAB
  SERVICES_TICKETS
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Campus {
  id        String    @id @default(cuid())
  name      String    @unique
  latitude  Float
  longitude Float
  domain    String?
  website   String?
  aliases   String[]  @default([])
  users     User[]
  listings  Listing[]
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  emailVerified Boolean    @default(false)
  phone         String?    @unique
  phoneVerified Boolean    @default(false)
  isAdmin       Boolean    @default(false)
  isPremium     Boolean    @default(false)
  premiumUntil  DateTime?
  isVerified    Boolean    @default(false)
  verifiedAt    DateTime?
  campusId      String
  campus        Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  dormZone      String?
  createdAt     DateTime   @default(now())

  listings             Listing[]
  favorites            Favorite[]
  buyerConversations   Conversation[]         @relation("BuyerConversations")
  sellerConversations  Conversation[]         @relation("SellerConversations")
  sentMessages         Message[]
  dailyUsages          DailyMessageUsage[]
  payments             PaymentRecord[]
  verificationRequests VerificationRequest[]
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String
  price       Float         // 0.0 indicates Free
  category    Category
  status      ListingStatus @default(AVAILABLE)
  imageUrl    String
  pickupSpot  String        @default("Campus Library / Main Gate")
  latitude    Float
  longitude   Float

  campusId    String
  campus      Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites     Favorite[]
  conversations Conversation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([campusId, createdAt])
  @@index([category])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PhoneOtpToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Conversation {
  id        String    @id @default(cuid())
  listingId String?
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)

  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId  String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId])
  @@index([sellerId])
}

enum CampusRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CampusRequest {
  id              String              @id @default(cuid())
  name            String
  city            String?
  state           String?
  latitude        Float
  longitude       Float
  domain          String?
  website         String?
  institutionType String?
  requesterName   String?
  requesterEmail  String?
  requesterPhone  String?
  note            String?
  status          CampusRequestStatus @default(PENDING)
  rejectionReason String?
  aiRecommendation String?            // "APPROVE" | "MANUAL_REVIEW" | "REJECT"
  aiConfidence    Float?              // 0 to 100
  aiReasoning     String?
  aiEvidence      String?             // JSON string of multi-point inspection
  aiCheckedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([domain])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model DailyMessageUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentPurpose {
  IDENTITY_VERIFICATION
  PREMIUM_SUBSCRIPTION
}

model PaymentRecord {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String         @unique
  paymentId      String?        @unique
  amount         Float          @default(10.0) // ₹10
  currency       String         @default("INR")
  status         PaymentStatus  @default(PENDING)
  purpose        PaymentPurpose @default(IDENTITY_VERIFICATION)
  idempotencyKey String?        @unique
  metadata       String?        // JSON metadata
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  verificationRequests VerificationRequest[]

  @@index([userId, status])
  @@index([orderId])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationRequest {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         PaymentRecord?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status          VerificationStatus @default(PENDING)
  studentIdNumber String?
  collegeEmail    String?
  documentUrl     String?
  rejectionReason String?
  reviewedBy      String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, status])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String?
  action     String   // e.g. "APPROVE_CAMPUS", "REJECT_CAMPUS", "APPROVE_VERIFICATION", "REJECT_VERIFICATION", "MERGE_CAMPUS"
  targetType String   // "CampusRequest", "VerificationRequest", "Campus", "User"
  targetId   String
  details    String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
